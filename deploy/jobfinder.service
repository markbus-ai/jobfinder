[Unit]
Description=JobFinder - Automated Job Search Pipeline
After=network.target

[Service]
Type=simple
User=jobfinder
Group=jobfinder
WorkingDirectory=/opt/jobfinder
ExecStart=/opt/jobfinder/venv/bin/python main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment
EnvironmentFile=/opt/jobfinder/.env

[Install]
WantedBy=multi-user.target
