# API Keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Telegram Notifications (Optional)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# Database (Optional, defaults to sqlite:///jobfinder.db)
DATABASE_URL=sqlite:///jobfinder.db
# Candidate location policy
# On-site and hybrid jobs are acceptable ONLY in CANDIDATE_CITY (default: Mar del Plata).
CANDIDATE_CITY=Mar del Plata
# Candidate country, used to detect foreign residence restrictions.
CANDIDATE_COUNTRY=Argentina
# Allow remote jobs. Set to false to block all remote listings. (true/false)
ALLOW_REMOTE=true
# Block remote listings that require residence in a foreign country (true/false).
BLOCK_FOREIGN_RESTRICTED_REMOTE=true
# Minimum AI technical match score (0-100) required to generate a CV and notify.
MIN_MATCH_SCORE=70
